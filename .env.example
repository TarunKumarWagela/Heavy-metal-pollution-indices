# ===================================================================
# HMPIAS Environment Configuration
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL.
# ===================================================================

# Application environment: development | production | testing
FLASK_ENV=development

# Host & Port configuration
HOST=127.0.0.1
PORT=5000

# Security: Secret key for session signing and cryptographic operations.
# Generate a secure key before starting the application:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database Connection URI
# SQLite (default for development):
DATABASE_URL=sqlite:///hmpias.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/hmpias

# File Upload Settings
MAX_CONTENT_LENGTH_MB=32
